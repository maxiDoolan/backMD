PORT=3000
MONGO_URL=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<base_de_datos>
JWT_SECRET=<un_string_largo_y_aleatorio>
JWT_EXPIRES_IN=1h
NODE_ENV=development

# Email (Nodemailer) — ej. Gmail: smtp.gmail.com / 587 / tu mail / contraseña de aplicación
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=<tu_mail@gmail.com>
MAIL_PASS=<contraseña_de_aplicacion>
MAIL_FROM="Plataforma de Eventos <tu_mail@gmail.com>"
