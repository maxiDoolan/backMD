              ],
              "path": [
                "api",
                "sessions",
                "current"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"La respuesta no contiene password\", () => pm.expect(pm.response.text()).to.not.include(\"password\"));",
                  "pm.test(\"Devuelve id, email y role\", () => pm.expect(pm.response.json().payload).to.have.all.keys(\"id\",\"email\",\"role\"));"
