            "url": {
              "raw": "{{baseUrl}}/api/sessions/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newEmail}}\",\n  \"password\": \"Clave123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Setea la cookie currentUser\", () => pm.expect(pm.cookies.has(\"currentUser\")).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current (con sesión)",
